# gtm-outbound — environment variables
#
# YOU DO NOT NEED THIS FILE FOR THE CORE SKILLS.
#
# The twelve core skills are standard-library Python and Markdown. They make no network
# calls and read no API keys. If you only use `offer`, `list`, `clay`, `copy`, `math`,
# `score`, `diagnose`, `reply`, `signals` and `ops` as reasoning + spec tools, stop here.
#
# These keys are for skills/gtm-outbound/optional/scripts/ — the Node/TypeScript helpers
# that automate the API-driven work. Copy to `.env` and fill in only what you use.
# Never commit `.env`.

# ---------------------------------------------------------------------------
# Sending platform
# ---------------------------------------------------------------------------
# https://smartlead.ai/ -> Settings -> API
SMARTLEAD_API_KEY=

# Alternative sending platform. https://instantly.ai/
INSTANTLY_API_KEY=

# ---------------------------------------------------------------------------
# Infrastructure: domains and inboxes
# ---------------------------------------------------------------------------
# Dynadot (registrar). Account -> Tools -> API -> API Key
# Request bulk API access if it is not already enabled.
DYNADOT_API_KEY=

# Zapmail (inbox provider). Account -> API -> Generate token
ZAPMAIL_API_KEY=

# ---------------------------------------------------------------------------
# List building
# ---------------------------------------------------------------------------
# https://prospeo.io/ -> API. This is the X-KEY header value.
PROSPEO_API_KEY=

# Blitz (domain-to-contacts). https://www.useblitz.com/
BLITZ_API_KEY=
BLITZ_BASE_URL=https://api.useblitz.com

# RapidAPI (Google Maps scraping, LinkedIn bulk data). https://rapidapi.com/
RAPIDAPI_KEY=

# Optional free-contact lane in the list waterfall. https://getleads.io/
GETLEADS_API_KEY=

# Optional lookalike lanes. Each missing key skips that lane; the run still completes.
# https://exa.ai/
EXA_API_KEY=
# https://parallel.ai/
PARALLEL_AI_API_KEY=

# ---------------------------------------------------------------------------
# Email validation
# ---------------------------------------------------------------------------
# https://www.millionverifier.com/ -> Dashboard -> API Key
MILLIONVERIFIER_API_KEY=

# ---------------------------------------------------------------------------
# AI qualification and personalization
# ---------------------------------------------------------------------------
# Used by the ICP qualification and per-lead personalization scripts.
OPENAI_API_KEY=
# Optional cheaper key for bulk qualification; preferred over OPENAI_API_KEY when set.
OPENAI_API_KEY_NANO=
# Optional model override (default: gpt-5-nano).
OPENAI_ICP_MODEL=

# https://openrouter.ai/ — alternative cheap personalization route.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Signal playbook data sources
# ---------------------------------------------------------------------------
# Clay CLI. `clay login` (browser OAuth) also works and is preferred.
CLAY_API_KEY=
# Apify: ad-library, linkedin-engagement, social-posts. https://apify.com/
APIFY_API_TOKEN=
# JS-rendering proxy for pages that return a bot wall or an empty JS shell:
# pricing-page, case-study-page, tech-on-website, social-link-finding.
ZENROWS_API_KEY=
# OpenWebNinja: company news and blog enrichment. https://www.openwebninja.com/
OPENWEBNINJA_KEY=

# ---------------------------------------------------------------------------
# Sender identity (used by bulk signature scripts)
# ---------------------------------------------------------------------------
SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SENDER_TITLE=
SENDER_COMPANY_NAME=
SENDER_WEBSITE=
# A real physical mailing address. Goes in the email footer. Required in most
# jurisdictions for commercial email — do not leave this blank in production.
SENDER_PHYSICAL_ADDRESS=

# ---------------------------------------------------------------------------
# Optional plumbing
# ---------------------------------------------------------------------------
# Cross-run dedup registry (Postgres). Unset -> per-run dedup only.
LIST_REGISTRY_DB_URL=
# Service-account JSON for pushing a lane to Google Sheets. Unset -> CSV only.
GOOGLE_APPLICATION_CREDENTIALS=
# Where list scripts drop run-metrics JSON.
RUN_METRICS_DIR=
# Prospeo pacing floor. Values below 450 are clamped, so this can only slow things down.
PROSPEO_MIN_INTERVAL_MS=
